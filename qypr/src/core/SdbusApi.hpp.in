// SdbusApi.hpp.in - sdbus-c++ v1/v2 compatibility (generated by CMake).
//
// v2 introduced the ServiceName/ObjectPath strong types and renamed
// processPendingRequest() to processPendingEvent(). Separately, newer
// releases made the two-argument addMatch() floating (older ones return an
// RAII slot). Both are compile checks, not version guesses.
#pragma once

#cmakedefine01 QYPR_SDBUS_HAS_SERVICE_NAME
#cmakedefine01 QYPR_SDBUS_ADD_MATCH_FLOATING
