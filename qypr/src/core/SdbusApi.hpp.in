// SdbusApi.hpp.in - sdbus-c++ v1/v2 compatibility (generated by CMake).
//
// v2 introduced the ServiceName/ObjectPath strong types and renamed
// processPendingRequest() to processPendingEvent(). CI images ship v1,
// developer machines v2; QYPR_SDBUS_HAS_SERVICE_NAME (from a compile check,
// not a version guess) selects the spelling.
#pragma once

#cmakedefine01 QYPR_SDBUS_HAS_SERVICE_NAME
